width=9;
depth=128;

%
 format of data and address stored in this file
 uns : unsigned, dec : decimal, hex : hexadecimal
 bin : binary, oct : octal
%

address_radix=hex;
data_radix=bin;

% ROM data %
content begin
00  :   001001000; -- mvi R1
   01  :   000000011; -- #3
   02  :   001010000; -- mvi R2
   03  :   000000001; -- #1
   04  :   010000000; -- add R0, R0
   05  :   011001010; -- sub R1, R2
   06  :   110000000; -- brne
   07  :   000000100; -- Jump address (0x04)
   
   [08..7F]  :   000000000;

end;
